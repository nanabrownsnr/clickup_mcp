# ClickUpMCP Configuration
# ==================================================

# Required: Encryption Key for token storage
# Used to encrypt API tokens and OAuth refresh tokens in MongoDB
# Must be URL-safe base64 encoding of a 16, 24, or 32-byte AES key.
# This variable MUST be set for the server to start.
# Use a strong, randomly generated key in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=DSZ9l2zqBU5b2Tndwubeyx0VNMa1lWh0LKnynV6J2S4

# ClickUp API Configuration
# The CLICKUP_API_TOKEN is optional at startup.
# Tokens are provided at runtime via /project/connect or /token/settings endpoints.
# Generate a Personal Access Token at https://app.clickup.com/api
# CLICKUP_API_TOKEN=your_clickup_api_token_here

# OAuth2 Configuration (optional - enables ClickUp OAuth2 login flow)
# Register an OAuth2 app at https://app.clickup.com/api to get client credentials
# CLICKUP_OAUTH_CLIENT_ID=your_clickup_oauth_client_id
# CLICKUP_OAUTH_CLIENT_SECRET=your_clickup_oauth_client_secret
# CLICKUP_OAUTH_REDIRECT_URI=http://your-domain.com/auth/callback
# CLICKUP_OAUTH_AUTH_BASE_URL=https://app.clickup.com
# CLICKUP_OAUTH_TOKEN_URL=https://api.clickup.com/api/v2/oauth/token
# CLICKUP_OAUTH_REVOKE_URL=https://api.clickup.com/api/v2/oauth/revoke
# CLICKUP_OAUTH_SCOPES=open

# MongoDB Connection
# Connection string for MongoDB instance (required for token storage)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=clickup_mcp
MONGODB_COLLECTION=api_tokens
MONGODB_OAUTH_COLLECTION=oauth_tokens
MONGODB_SESSION_COLLECTION=oauth_sessions

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated origins or * for all)
CORS_ORIGINS=*

# Persona Header (used for multi-tenant scoping)
PERSONA_HEADER=X-Persona-ID
